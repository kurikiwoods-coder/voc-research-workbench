{"$schema":"http://json-schema.org/draft-07/schema#","description":"One entry per batch, bound to batch_id in the unified table. Any quoted number must trace back to a batch. Source: PDT v1.2 §8.1.","properties":{"batch_id":{"type":"string"},"collected_at":{"format":"date-time","type":"string"},"collection_method":{"enum":["search_api","site_api","licensed_page","manual","csv_upload","snapshot"],"type":"string"},"collector":{"type":"string"},"engine":{"enum":["tavily","brave","manual","other"],"type":"string"},"excluded_n":{"minimum":0,"type":"integer"},"exclusion_reasons":{"additionalProperties":{"type":"integer"},"description":"Excluded count by reason","type":"object"},"exclusion_rules":{"description":"Exclusion rules applied to this batch","type":"string"},"n":{"description":"Number of records in this batch","minimum":0,"type":"integer"},"notes":{"type":"string"},"query_terms":{"description":"Search terms / community used","items":{"type":"string"},"type":"array"},"source":{"description":"Source name, e.g. forum name, subreddit, YouTube channel, CSV file name","type":"string"},"time_window":{"properties":{"end":{"format":"date","type":"string"},"start":{"format":"date","type":"string"}},"required":["start","end"],"type":"object"}},"required":["batch_id","source","time_window","collection_method","n","exclusion_rules"],"title":"Sampling Log Entry","type":"object"}