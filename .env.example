# Use the local API setup page for interactive configuration.
# Optional server environment fallback. Keep real values out of Git.
JEV_PROVIDER=jevmodel
JEVMODEL_API_KEY=
TYPESAFE_API_KEY=
PACKYCODE_API_KEY=
TAVILY_API_KEY=
BRAVE_API_KEY=
YOUTUBE_API_KEY=
# Optional absolute paths outside Git. See docs/connectivity.md for the review format.
JEV_REVIEW_FILE=
VOC_DATA_DIR=
# Optional confirmed total account input-token allowance, used for the percentage.
JEV_TOKEN_CAPACITY=

# Optional trusted service setup. The default is Business on the local machine.
# Changing this requires restarting the whole service in its own data directory.
# VOC_EDITION=BUSINESS
# VOC_DEPLOYMENT=LOCAL
# For Personal/Local only. See docs/architecture/g1-personal-server-policy.md.
# VOC_PERSONAL_OPERATOR_REF=
# VOC_PERSONAL_OWNER_REF=
# VOC_PERSONAL_OWNER_SHA256=
# VOC_PERSONAL_PROJECT_GRANTS=[]
